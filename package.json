{
  "name": "pantry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-pantry",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit -p worker",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.31.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.143.1"
  }
}
